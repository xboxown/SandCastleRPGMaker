<Window x:Class="SandcastleRpgMaker.Editor.PlayMusicCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Play Music" Height="230" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Music:" FontWeight="Bold" Margin="0,0,0,4"/>
        <ComboBox x:Name="MusicCombo" DockPanel.Dock="Top" Margin="0,0,0,4"/>
        <TextBlock x:Name="EmptyListNote" DockPanel.Dock="Top" Text="No music yet - add some in the Sound Editor first." Opacity="0.7" FontSize="11" Margin="0,0,0,10" Visibility="Collapsed"/>

        <TextBlock DockPanel.Dock="Top" Text="Volume (0.0 - 1.0):" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox x:Name="VolumeBox" DockPanel.Dock="Top"/>
        <CheckBox x:Name="LoopBox" DockPanel.Dock="Top" Content="Loops (plays over and over until Stop / Fade Music or another Play Music)" Margin="0,8,0,0"/>
    </DockPanel>
</Window>
