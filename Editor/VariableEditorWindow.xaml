<Window x:Class="SandcastleRpgMaker.Editor.VariableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Variable Editor" Height="500" Width="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <ToolBar DockPanel.Dock="Top">
            <Button Content="New Variable..." Click="NewVariable_Click" Padding="6,2" Margin="2"/>
            <Button Content="Rename..." Click="Rename_Click" Padding="6,2" Margin="2"/>
            <Button Content="Change Type..." Click="ChangeType_Click" Padding="6,2" Margin="2"/>
            <Button Content="Delete" Click="Delete_Click" Padding="6,2" Margin="2"/>
        </ToolBar>

        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,6,0,0"
                   Text="These are GLOBAL variables - visible from every book (and, later, every other editor). Local variables are still created inline from a book's own condition/command pickers, and stay separate from this list."/>

        <ListView x:Name="VariablesListView" Margin="0,8,0,0" MouseDoubleClick="Rename_Click">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding Type}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
