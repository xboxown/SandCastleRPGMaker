<Window x:Class="SandcastleRpgMaker.Editor.ShowTextCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Show Text" Height="760" Width="1000" MinHeight="560" MinWidth="820" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: what the box says and how it looks -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Title (optional)" FontWeight="Bold" ToolTip="A heading written above the text in the box - a name, a place, anything. Leave it empty for none."/>
                    <TextBox x:Name="TitleBox" Margin="0,2,0,8" TextChanged="Any_Changed"/>
                    <TextBlock Text="Text" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Speaker" ToolTip="Who is talking: their face shows in the box. A character must be in sight (on screen) for their line to show."/>
                            <ComboBox x:Name="SpeakerCombo" SelectionChanged="Any_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Face"/>
                            <ComboBox x:Name="FaceSideCombo" SelectedIndex="0" SelectionChanged="Any_Changed">
                                <ComboBoxItem Content="Left"/>
                                <ComboBoxItem Content="Right"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dialog Frame" ToolTip="The box's look - a sprite from the DialogFrame group (Sprite Editor). None = no box, just the text."/>
                            <ComboBox x:Name="FrameCombo" SelectionChanged="Any_Changed"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="?" Width="24" Margin="4,16,0,0" VerticalAlignment="Top" ToolTip="How dialog frames work, and what size to draw them" Click="FrameHelp_Click"/>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Window Position"/>
                            <ComboBox x:Name="PositionCombo" SelectedIndex="2" SelectionChanged="Any_Changed">
                                <ComboBoxItem Content="Top"/>
                                <ComboBoxItem Content="Middle"/>
                                <ComboBoxItem Content="Bottom"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="DimCheck" Content="Dim the screen behind the box" Margin="0,8,0,0" Checked="Any_Changed" Unchecked="Any_Changed"/>

                    <TextBlock Text="Preview (the game screen, 320 x 200)" FontWeight="Bold" Margin="0,12,0,4"/>
                    <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left">
                        <Viewbox Width="480" Height="300" Stretch="Uniform">
                            <Grid Width="320" Height="200" ClipToBounds="True">
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3A5A2A" Offset="0"/>
                                            <GradientStop Color="#6B5B3A" Offset="0.5"/>
                                            <GradientStop Color="#2F4F5F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Canvas x:Name="PreviewCanvas" Width="320" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Viewbox>
                    </Border>
                </StackPanel>

                <TextBox x:Name="TextBox1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="80" TextChanged="Any_Changed"/>
            </DockPanel>

            <!-- Right: the replies -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Replies (optional)" FontWeight="Bold"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,6"
                               Text="What the player can answer - any words: &quot;name&quot;, &quot;job&quot;, &quot;bye&quot;, &quot;Who are you?&quot;... Each reply gets its own &quot;When&quot; branch under this Show Text in the command list: put in it what happens when it's picked - another Show Text (the next dialog box, with its own replies), Jump to Label to go back to an earlier box, or any command (attack, die, give an item, set a variable...). When a branch runs out, the conversation is over. No replies = a plain message box."/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock Text="Reply text"/>
                    <TextBox x:Name="ReplyTextBox" Margin="0,2,0,6" TextChanged="ReplyTextBox_TextChanged"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConditionButton" Content="Show only when..." Padding="8,3" Click="ConditionButton_Click"
                                ToolTip="A condition for this reply to be offered: variables, stats, the party having or not having an item, or only once."/>
                        <Button x:Name="ClearConditionButton" Content="Always show it" Padding="8,3" Margin="6,0,0,0" Click="ClearConditionButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ConditionSummary" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                    <Button Content="Add" Width="80" Margin="0,0,0,4" Click="AddReply_Click"/>
                    <Button Content="Delete" Width="80" Margin="0,0,0,12" Click="DeleteReply_Click"/>
                    <Button Content="Move Up" Width="80" Margin="0,0,0,4" Click="MoveUp_Click"/>
                    <Button Content="Move Down" Width="80" Click="MoveDown_Click"/>
                </StackPanel>

                <ListBox x:Name="RepliesList" SelectionChanged="RepliesList_SelectionChanged"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
