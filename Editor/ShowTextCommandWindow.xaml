<Window x:Class="SandcastleRpgMaker.Editor.ShowTextCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Show Text" Height="320" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Background"/>
                <ComboBox x:Name="BackgroundCombo" SelectedIndex="0">
                    <ComboBoxItem Content="Window"/>
                    <ComboBoxItem Content="Dim"/>
                    <ComboBoxItem Content="Transparent"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Window Position"/>
                <ComboBox x:Name="PositionCombo" SelectedIndex="2">
                    <ComboBoxItem Content="Top"/>
                    <ComboBoxItem Content="Middle"/>
                    <ComboBoxItem Content="Bottom"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="Text:" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox x:Name="TextBox1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="140"/>
    </DockPanel>
</Window>
