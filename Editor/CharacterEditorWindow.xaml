<Window x:Class="SandcastleRpgMaker.Editor.CharacterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SandcastleRpgMaker.Editor"
        Title="Character Editor" Height="680" Width="960" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="80" Margin="4" Click="CloseButton_Click"/>
        </StackPanel>

        <DockPanel Grid.Column="0" Margin="0,0,10,0" Width="220" DockPanel.Dock="Left">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="New" Width="60" Margin="2" Click="NewCharacter_Click"/>
                <Button Content="Delete" Width="60" Margin="2" Click="DeleteCharacter_Click"/>
            </StackPanel>
            <ListBox x:Name="CharacterListBox" DisplayMemberPath="Name" SelectionChanged="CharacterListBox_SelectionChanged"/>
        </DockPanel>

        <TabControl x:Name="DetailsTabs" IsEnabled="False">
            <TabItem Header="Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailsPanel" Margin="10,10,0,0">
                    <TextBlock Text="Name" FontWeight="Bold"/>
                    <TextBox x:Name="NameBox" Margin="0,2,0,10" TextChanged="Field_Changed"/>

                    <TextBlock Text="Age" FontWeight="Bold"/>
                    <TextBox x:Name="AgeBox" Margin="0,2,0,10" Width="80" HorizontalAlignment="Left" TextChanged="Field_Changed"/>

                    <TextBlock Text="Gender" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                        <RadioButton x:Name="MaleRadio" Content="Male" GroupName="Gender" Margin="0,0,16,0" Checked="Field_Changed"/>
                        <RadioButton x:Name="FemaleRadio" Content="Female" GroupName="Gender" Checked="Field_Changed"/>
                    </StackPanel>

                    <TextBlock Text="Class" FontWeight="Bold"/>
                    <ComboBox x:Name="ClassCombo" Margin="0,2,0,10" SelectionChanged="Field_Changed"/>

                    <TextBlock Text="Faction" FontWeight="Bold"/>
                    <ComboBox x:Name="FactionCombo" Margin="0,2,0,10" DisplayMemberPath="Name" SelectionChanged="Field_Changed"
                              ToolTip="Who this character sides with - how it treats everyone else and how they treat it (Tools &gt; Faction Editor)"/>

                    <CheckBox x:Name="TestPlayerCheck" Content="Is Main Player" Margin="0,0,0,2" Checked="Field_Changed" Unchecked="Field_Changed"
                              ToolTip="The character the person playing controls (only one character can be the main player). Every other character is run by AI and follows its schedule."/>
                    <TextBlock x:Name="MainPlayerNote" Text="Controlled by the person playing: no AI, no schedule." Opacity="0.7" FontSize="11" Margin="20,0,0,4" Visibility="Collapsed"/>
                    <CheckBox x:Name="InPartyCheck" Content="In active party (their own inventory/paperdoll can be opened even when not the test player)" Margin="0,0,0,10" Checked="Field_Changed" Unchecked="Field_Changed"/>

                    <TextBlock Text="Size (Exult 3D size)" FontWeight="Bold"/>
                    <TextBlock Text="Footprint X/Y in 8px world units, Height Z in lifts - used for collision, climbing and headroom exactly like Exult (you can't walk into or under anything lower than you are tall). Filled in automatically from the Idle sprite; adjust if needed." Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="SizeXBox" Width="40" Margin="0,0,10,0" TextChanged="SizeBox_TextChanged"/>
                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="SizeYBox" Width="40" Margin="0,0,10,0" TextChanged="SizeBox_TextChanged"/>
                        <TextBlock Text="Z" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="SizeZBox" Width="40" Margin="0,0,10,0" TextChanged="SizeBox_TextChanged"/>
                        <Button Content="Auto" Padding="8,1" Click="AutoSize_Click" ToolTip="Recompute from the Idle sprite"/>
                    </StackPanel>

                    <TextBlock Text="Face" FontWeight="Bold"/>
                    <DockPanel Margin="0,2,0,4">
                        <CheckBox x:Name="FaceFilterCheck" DockPanel.Dock="Right" Content="Filter By Group" VerticalAlignment="Center" Margin="8,0,0,0"
                                  Checked="FaceFilterCheck_Checked" Unchecked="FaceFilterCheck_Unchecked"/>
                        <ComboBox x:Name="FaceCombo" SelectionChanged="Field_Changed" DisplayMemberPath="Name"/>
                    </DockPanel>
                    <TextBlock x:Name="FaceEmptyNote" Text="No sprites available yet - add one in the Sprite Editor first." Opacity="0.7" FontSize="11" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <TextBlock Text="Stats" FontWeight="Bold" Margin="0,6,0,4"/>
                    <ItemsControl x:Name="StatsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,0,0,4" ToolTip="The highest level this character can reach by experience. 0 = the game's Max Level (System Settings > Levels). Monsters level up too, from their kills.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Level Lock (0 = game's max)" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="LevelLockBox" LostFocus="LevelLockBox_LostFocus"/>
                    </Grid>
                    <TextBlock Text="EXP: what killing it gives its killer (and what it has gained). Level, Training Points and Next Exp follow the level curve in System Settings > Levels." Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>

                    <DockPanel Margin="0,10,0,4">
                        <Button DockPanel.Dock="Right" Content="Add Custom Pose..." Click="AddCustomPose_Click"/>
                        <TextBlock Text="Poses" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel x:Name="PosesPanel"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Inventory / Paperdoll">
                <Grid Margin="10,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Paperdoll Body Sprite" FontWeight="Bold"/>
                        <DockPanel Margin="0,2,0,4">
                            <CheckBox x:Name="PaperdollFilterCheck" DockPanel.Dock="Right" Content="Filter By Group" VerticalAlignment="Center" Margin="8,0,0,0"
                                      Checked="PaperdollFilterCheck_Checked" Unchecked="PaperdollFilterCheck_Unchecked"/>
                            <ComboBox x:Name="PaperdollBodyCombo" SelectionChanged="PaperdollBody_Changed" DisplayMemberPath="Name"/>
                        </DockPanel>
                        <TextBlock Text="Exit Button Sprite (2 frames - frame 1 unpressed, frame 2 pressed)" FontWeight="Bold" Margin="0,8,0,0"/>
                        <DockPanel Margin="0,2,0,4">
                            <CheckBox x:Name="ExitButtonFilterCheck" DockPanel.Dock="Right" Content="Filter By Group" VerticalAlignment="Center" Margin="8,0,0,0"
                                      Checked="ExitButtonFilterCheck_Checked" Unchecked="ExitButtonFilterCheck_Unchecked"/>
                            <ComboBox x:Name="ExitButtonCombo" SelectionChanged="ExitButtonSprite_Changed" DisplayMemberPath="Name"/>
                        </DockPanel>
                        <ComboBox x:Name="PaperdollNavigateSoundCombo" SelectionChanged="PaperdollNavigateSound_Changed" DisplayMemberPath="Name" Visibility="Collapsed"/>
                        <TextBlock Text="Open Sound" FontWeight="Bold" Margin="0,8,0,0"/>
                        <TextBlock Text="Plays when this character's paperdoll is opened in the game." Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <ComboBox x:Name="PaperdollOpenSoundCombo" SelectionChanged="PaperdollOpenSound_Changed" DisplayMemberPath="Name" Margin="0,0,0,4"/>
                        <TextBlock Text="Drag any slot marker to reposition it on the body - this is exactly where that slot's icon will draw in-game and in the in-game paperdoll window. Custom slots (green) can be added below, then deleted by clicking one here and pressing Delete." Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="AddCustomSlotButton" DockPanel.Dock="Left" Content="Add Custom Slot" Padding="8,3" Margin="0,0,8,0" Click="AddCustomSlotButton_Click"/>
                            <TextBlock x:Name="CustomSlotNameLabel" DockPanel.Dock="Left" Text="Name:" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed"/>
                            <TextBox x:Name="CustomSlotNameBox" Width="140" Visibility="Collapsed" TextChanged="CustomSlotNameBox_TextChanged"/>
                        </DockPanel>
                        <Border BorderBrush="#FF555555" BorderThickness="1">
                            <Canvas x:Name="PaperdollCanvas" Width="320" Height="400" Background="#FF2A2A2A" ClipToBounds="True" Focusable="True"
                                    MouseLeftButtonDown="PaperdollCanvas_MouseLeftButtonDown" MouseMove="PaperdollCanvas_MouseMove" MouseLeftButtonUp="PaperdollCanvas_MouseLeftButtonUp"
                                    KeyDown="PaperdollCanvas_KeyDown"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Expand... (slots on/off, weight, buttons)" Padding="8,3" Margin="0,0,6,0" Click="ExpandPaperdollButton_Click"/>
                            <Button Content="Stats paperdoll..." Padding="8,3" Click="StatsDollButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Starting Inventory" FontWeight="Bold"/>
                        <TextBlock Text="What this character carries at the start of a new game, placed by the same rules as picking it up in play: a container goes in its own slot (Location), else a hand; anything else goes into the Backpack container, then the Pouch container while there is room, else a hand. When everything is full, nothing more can be added." Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <DockPanel Margin="0,0,0,6">
                            <ComboBox x:Name="InventoryCategoryCombo" DockPanel.Dock="Left" Width="150" Margin="0,0,6,0"/>
                            <ComboBox x:Name="InventoryItemCombo" DockPanel.Dock="Left" Width="180" Margin="0,0,6,0" DisplayMemberPath="Name"/>
                            <Button Content="Add" Width="60" Click="AddInventoryItem_Click"/>
                        </DockPanel>
                        <ListBox x:Name="InventoryListBox" Height="300" DisplayMemberPath="DisplayText"/>
                        <TextBlock x:Name="InventoryWeightText" Opacity="0.75" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <Button Content="Remove Selected" Width="120" HorizontalAlignment="Left" Margin="0,6,0,0" Click="RemoveInventoryItem_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="HealthTab" Header="Health" ToolTip="Hunger, poison and ailment immunities">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HealthPanel" Margin="10"/>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="VerboseTab" Header="Verbose" ToolTip="Human or not, how it treats doors, and what it says (hunger, getting hit, fear, theft warnings...)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="VerbosePanel" Margin="10"/>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TalkTab" Header="Talk" ToolTip="What happens when the player double-clicks this character (not for the main player)">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                               Text="Runs when the player double-clicks this character (Exult: talking to an NPC). Use Show Text with Speaker = Self for the character's lines - its face shows in the box. Give a Show Text replies (name, job, bye, or any words) and each reply gets its own branch of commands - the next box, a Jump to Label back to an earlier one, or anything else (attack, give an item...). A party member's inventory opens instead while a gump is open, as in Exult."/>
                    <ContentControl x:Name="TalkEditorHost"/>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="EventTab" Header="Event" ToolTip="This character's own events: By Equip, By UnEquip, By Hit, By Ailment Effect, By Death">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Debug" Padding="10,4" Click="CharacterEventDebugButton_Click"/>
                        <TextBlock Text="Fires for this character - the main player included. In the commands, Self is this character."
                                   VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
                            <local:BookEventConditionsControl x:Name="CharacterConditionsControl"/>
                        </Border>
                        <ContentControl x:Name="CharacterEventEnginePlaceholder" Grid.Column="1"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="ScheduleTab" Header="Schedule" ToolTip="Where this character goes and what it does through the day (not for the main player)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SchedulePanel" Margin="10"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
