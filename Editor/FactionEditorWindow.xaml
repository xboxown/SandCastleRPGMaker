<Window x:Class="SandcastleRpgMaker.Editor.FactionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Faction Editor" Height="500" Width="600" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="New Faction" Click="NewFaction_Click" Padding="6,2" Margin="2"/>
            <Button Content="Delete Selected" Click="DeleteFaction_Click" Padding="6,2" Margin="2"/>
            <Separator/>
            <Button Content="Save..." Click="Save_Click" Padding="6,2" Margin="2"/>
            <Button Content="Load..." Click="Load_Click" Padding="6,2" Margin="2"/>
        </ToolBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="FactionListBox" Grid.Column="0" Margin="6" DisplayMemberPath="Name"
                     SelectionChanged="FactionListBox_SelectionChanged"/>
            <StackPanel Grid.Column="1" Margin="12" x:Name="EditorPanel" IsEnabled="False">
                <TextBlock Text="Name" FontWeight="Bold"/>
                <TextBox x:Name="NameBox" Margin="0,2,0,10" TextChanged="Field_Changed"/>
                <TextBlock Text="Notes" FontWeight="Bold"/>
                <TextBox x:Name="NotesBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Field_Changed"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
