<Window x:Class="SandcastleRpgMaker.Editor.EditCustomTileEffectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Tile Effect" Height="620" Width="460"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Effect name" FontWeight="Bold"/>
                <TextBox x:Name="NameBox" Margin="0,2,0,10"/>

                <TextBlock Text="Trigger" FontWeight="Bold"/>
                <ComboBox x:Name="TriggerCombo" Margin="0,2,0,10"/>

                <TextBlock Text="Tick interval (seconds, for On Stay)" FontWeight="Bold"/>
                <TextBox x:Name="TickIntervalBox" Text="1.0" Margin="0,2,0,10"/>

                <TextBlock Text="Damage per tick" FontWeight="Bold"/>
                <TextBox x:Name="DamagePerTickBox" Text="0" Margin="0,2,0,10"/>

                <CheckBox x:Name="RampingCheck" Content="Ramping damage (grows the longer you're exposed)" Margin="0,4,0,4"/>
                <TextBlock Text="Ramp increase per tick" Margin="20,0,0,2"/>
                <TextBox x:Name="RampIncreaseBox" Text="0" Margin="20,0,0,10" Width="150" HorizontalAlignment="Left"/>

                <TextBlock Text="Mitigating gear (equip any one of these to negate/reduce this effect)" FontWeight="Bold" TextWrapping="Wrap"/>
                <ListBox x:Name="MitigatingObjectsListBox" Height="120" Margin="0,4,0,10" SelectionMode="Multiple"
                         DisplayMemberPath="Name"/>

                <TextBlock Text="Recovery time (seconds after leaving before this fully clears)" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBox x:Name="RecoverySecondsBox" Text="0" Margin="0,2,0,10"/>

                <TextBlock Text="Notes" FontWeight="Bold"/>
                <TextBox x:Name="NotesBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,2,0,10"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
