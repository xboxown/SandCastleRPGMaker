<Window x:Class="SandcastleRpgMaker.Editor.SelectVariableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Variable" Height="460" Width="380" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <TabControl x:Name="ScopeTabs" SelectionChanged="ScopeTabs_SelectionChanged">
            <TabItem Header="Local">
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Bottom" x:Name="NewVariableButton" Content="New Variable..." HorizontalAlignment="Left" Margin="0,8,0,0" Click="NewVariableButton_Click"/>
                    <ListView x:Name="LocalListView" MouseDoubleClick="LocalListView_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="Global">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Bottom" Text="Global variables can only be selected here, not created - use the project's variable list to add new ones." TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray" Margin="0,8,0,0"/>
                    <ListView x:Name="GlobalListView" MouseDoubleClick="GlobalListView_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
