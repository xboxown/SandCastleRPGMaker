<Window x:Class="SandcastleRpgMaker.Editor.SpriteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SandcastleRpgMaker.Editor"
        Title="Sprite Editor" Height="600" Width="800" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="New Folder..." Click="NewGroup_Click" Padding="6,2" Margin="2"/>
            <Button Content="Delete Folder" Click="DeleteGroup_Click" Padding="6,2" Margin="2"/>
            <Separator/>
            <Button Content="New Sprite..." Click="NewSprite_Click" Padding="6,2" Margin="2"/>
            <Button Content="Add Sprite..." Click="AddSprite_Click" Padding="6,2" Margin="2"/>
            <Button Content="Edit Sprite..." Click="EditSprite_Click" Padding="6,2" Margin="2"/>
            <Button Content="Remove Sprite" Click="RemoveSprite_Click" Padding="6,2" Margin="2"/>
            <Separator/>
            <Button Content="Save..." Click="Save_Click" Padding="6,2" Margin="2"/>
            <Button Content="Load..." Click="Load_Click" Padding="6,2" Margin="2"/>
        </ToolBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Folders" FontWeight="Bold" Margin="6"/>
                <!-- Built in code (SpriteEditorWindow.RefreshGroups): each folder with how many sprites it holds and its identity's badge.
                     Red: the built-in folders; orange: given an identity; purple: holds a single sprite. Right-click: identity, rename, delete. -->
                <ListBox x:Name="GroupListBox" Margin="6" SelectionChanged="GroupListBox_SelectionChanged"/>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="Sprites in the folder (right-click: cut, copy, paste, rename, delete)" FontWeight="Bold" Margin="6"/>
                <ListView x:Name="SpriteListView" Margin="6" SelectionMode="Extended" MouseDoubleClick="SpriteListView_MouseDoubleClick" MouseRightButtonUp="SpriteListView_MouseRightButtonUp">
                    <!-- The two locked font sprites (SpriteDatabase.InGameFontName / DialogFontName) show red like their group. -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Name}" Value="InGameFont">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Name}" Value="DialogFont">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <!-- What it looks like (animated, no sound) without opening it. -->
                            <GridViewColumn Header="Look" Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:SpritePreview Sprite="{Binding}" Width="40" Height="32"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="File" Width="400" DisplayMemberBinding="{Binding DisplayLocation}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
