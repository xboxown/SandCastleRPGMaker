<Window x:Class="SandcastleRpgMaker.Editor.ApplyPaletteColorCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Palette Color" Height="520" Width="440" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,0,0,8"
                   Text="Every color here comes from a real, user-provided Ultima 7 PALETTES.FLX, grouped by which of the 12 real lighting/effect palettes it belongs to. Click a swatch to preview it, then adjust how strongly it overlays the scene."/>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Rectangle x:Name="SelectedColorSwatch" Width="32" Height="32" Stroke="Black" StrokeThickness="1" DockPanel.Dock="Left" Margin="0,0,8,0" Fill="Transparent"/>
            <TextBlock x:Name="SelectedColorLabel" Text="No color selected yet" VerticalAlignment="Center" FontWeight="Bold"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="Overlay strength:" FontWeight="Bold" Margin="0,0,0,4"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" x:Name="OpacityValueLabel" Text="40%" Width="40" TextAlignment="Right"/>
            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                    ValueChanged="OpacitySlider_ValueChanged" Margin="0,0,8,0"/>
        </DockPanel>

        <TabControl x:Name="GroupTabs"/>
    </DockPanel>
</Window>
