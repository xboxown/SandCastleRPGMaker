<Window x:Class="SandcastleRpgMaker.Editor.EditEventCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command" Height="420" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Command type" FontWeight="Bold"/>
            <ComboBox x:Name="CommandTypeCombo" Margin="0,4,0,10" SelectionChanged="CommandTypeCombo_SelectionChanged"/>

            <TextBlock Text="Indent level (nesting for If / Else / End If)" FontWeight="Bold"/>
            <TextBox x:Name="IndentBox" Text="0" Width="50" HorizontalAlignment="Left" Margin="0,4,0,10"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DynamicFieldsPanel"/>
        </ScrollViewer>
    </DockPanel>
</Window>
