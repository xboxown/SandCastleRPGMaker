<Window x:Class="SandcastleRpgMaker.Editor.TilePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SandcastleRpgMaker.Editor"
        Title="Tile Properties" Height="700" Width="1050"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="TileIndexLabel" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl>
            <TabItem Header="Properties">
                <DockPanel Margin="10,10,10,0">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Terrain label (for your own reference)" FontWeight="Bold"/>
                        <TextBox x:Name="TerrainLabelBox" Margin="0,2,0,10"/>

                        <CheckBox x:Name="WalkableCheck" Content="Walkable" Margin="0,4,0,10"/>

                        <TextBlock Text="Required gear to enter this tile at all (equip/carry any one)" FontWeight="Bold" TextWrapping="Wrap"/>
                        <ListBox x:Name="RequiredObjectsListBox" Height="100" Margin="0,4,0,10" SelectionMode="Multiple"
                                 DisplayMemberPath="Name"/>
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Vertical">
                            <Button x:Name="AddEffectButton" Content="Add..." Width="90" Margin="4" Click="AddEffectButton_Click"/>
                            <Button x:Name="EditEffectButton" Content="Edit..." Width="90" Margin="4" Click="EditEffectButton_Click"/>
                            <Button x:Name="RemoveEffectButton" Content="Remove" Width="90" Margin="4" Click="RemoveEffectButton_Click"/>
                        </StackPanel>
                        <TextBlock Text="Custom effects (open-ended rule engine) - each one also becomes a &quot;(C)&quot;-marked preset in the right-click Properties menu automatically."
                                   FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    </DockPanel>

                    <ListBox x:Name="EffectsListBox"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Event">
                <DockPanel Margin="10,10,10,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="TileEventDebugButton" Content="Debug" Padding="10,4" Click="TileEventDebugButton_Click"/>
                        <TextBlock Text="Evaluates this page's conditions against a simulated scenario, then (if they pass) lets you step through its commands one at a time - a real command executes for real when you step onto it."
                                   VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
                            <local:BookEventConditionsControl x:Name="TileConditionsControl"/>
                        </Border>
                        <ContentControl x:Name="TileEventEnginePlaceholder" Grid.Column="1"/>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
