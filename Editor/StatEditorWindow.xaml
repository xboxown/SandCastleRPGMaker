<Window x:Class="SandcastleRpgMaker.Editor.StatEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SandcastleRpgMaker.Editor"
        Title="Stat Editor" Height="500" Width="480" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:LockGlyphConverter x:Key="LockGlyphConverter"/>
    </Window.Resources>
    <DockPanel Margin="8">
        <ToolBar DockPanel.Dock="Top">
            <Button Content="New Stat..." Click="NewStat_Click" Padding="6,2" Margin="2"/>
            <Button Content="Rename..." Click="Rename_Click" Padding="6,2" Margin="2"/>
            <Button Content="Change Type..." Click="ChangeType_Click" Padding="6,2" Margin="2"/>
            <Button Content="Delete" Click="Delete_Click" Padding="6,2" Margin="2"/>
        </ToolBar>

        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,6,0,0"
                   Text="Every condition and complex-condition panel that lists stats reads this same list live - a stat added here shows up everywhere immediately, no separate step needed. Locked (🔒) stats can be renamed, but not deleted or retyped."/>

        <ListView x:Name="StatsListView" Margin="0,8,0,0" MouseDoubleClick="Rename_Click">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsBuiltIn, Converter={StaticResource LockGlyphConverter}}" ToolTip="Built-in stat - can be renamed, but not deleted or retyped"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Type" Width="140" DisplayMemberBinding="{Binding Type}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
