<Window x:Class="SandcastleRpgMaker.Editor.SelectGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Group" Height="420" Width="340" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Choose a sprite group:" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
        <ListBox x:Name="GroupListBox" MouseDoubleClick="GroupListBox_MouseDoubleClick"/>
    </DockPanel>
</Window>
