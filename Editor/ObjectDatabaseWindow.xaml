<Window x:Class="SandcastleRpgMaker.Editor.ObjectDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SandcastleRpgMaker.Editor"
        Title="Object Database" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <DockPanel>

        <ToolBar DockPanel.Dock="Top">
            <Button x:Name="NewObjectButton" Content="New Object" Click="NewObjectButton_Click" Padding="6,2" Margin="2"/>
            <Button x:Name="DeleteObjectButton" Content="Delete Selected" Click="DeleteObjectButton_Click" Padding="6,2" Margin="2"/>
            <Separator/>
            <Button x:Name="SaveDbButton" Content="Save Database..." Click="SaveDbButton_Click" Padding="6,2" Margin="2"/>
            <Button x:Name="LoadDbButton" Content="Load Database..." Click="LoadDbButton_Click" Padding="6,2" Margin="2"/>
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ObjectListBox" Grid.Column="0" Margin="6"
                     DisplayMemberPath="Name"
                     SelectionChanged="ObjectListBox_SelectionChanged"/>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" x:Name="EditorPanel" IsEnabled="False">
                <TextBlock Text="Name" FontWeight="Bold"/>
                <TextBox x:Name="NameBox" Margin="0,2,0,10" TextChanged="Field_Changed"/>

                <TextBlock Text="Description" FontWeight="Bold"/>
                <TextBox x:Name="DescriptionBox" Margin="0,2,0,10" Height="60"
                         AcceptsReturn="True" TextWrapping="Wrap" TextChanged="Field_Changed"/>

                <TextBlock Text="Icon" FontWeight="Bold"/>
                <DockPanel Margin="0,2,0,10">
                    <Button Content="Browse..." DockPanel.Dock="Right" Click="BrowseIcon_Click" Padding="6,2"/>
                    <TextBox x:Name="IconPathBox" IsReadOnly="True" Margin="0,0,6,0"/>
                </DockPanel>
                <Image x:Name="IconPreview" Height="48" Width="48" HorizontalAlignment="Left"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,0,10"/>

                <CheckBox x:Name="PortableCheck" Content="Portable (can be picked up / carried)" Margin="0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                <CheckBox x:Name="StackableCheck" Content="Stackable (multiple combine into one slot)" Margin="0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                <DockPanel Margin="20,0,0,4">
                    <TextBlock Text="Max stack size (0 = unlimited):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="MaxStackBox" Width="60" TextChanged="Field_Changed"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,4">
                    <TextBlock Text="Volume (how much space this takes up in a container):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="VolumeBox" Width="60" TextChanged="Field_Changed"/>
                </DockPanel>
                <CheckBox x:Name="ContainerCheck" Content="Container (can hold other objects)" Margin="0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                <CheckBox x:Name="InteractableCheck" Content="Interactable (clicking triggers a reaction)" Margin="0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                <CheckBox x:Name="OccludesCheck" Content="Occludes (blocks line of sight - walls, tall furniture)" Margin="0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                <CheckBox x:Name="IsSolidCheck" Content="Solid (blocks movement - a real, separate flag from Occludes)" Margin="0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                <local:SolidSizeEditor x:Name="SolidSize" HorizontalAlignment="Left" Margin="20,4,0,8"/>
                <CheckBox x:Name="IsTwoHandedCheck" Content="Two-Handed (needs both hands - a weapon in the right hand makes left hand unavailable while equipped)" Margin="0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                <CheckBox x:Name="NpcCheck" Content="Is NPC (living, has schedule/dialogue later)" Margin="0,4" Checked="Field_Changed" Unchecked="Field_Changed"/>
                <DockPanel Margin="0,8,0,2">
                    <TextBlock Text="Use As:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="UseAsCombo" Width="140" HorizontalAlignment="Left" SelectionChanged="UseAsCombo_SelectionChanged"/>
                </DockPanel>
                <TextBlock Text="Key: double-click it in play, then click a container to lock or unlock it (it must be that container's Required Key). Lockpick: double-click, then click a locked container to try to pick it; a failed try breaks the pick." Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</Window>
