<Window x:Class="SandcastleRpgMaker.Editor.BookEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SandcastleRpgMaker.Editor"
        Title="Book Editor" Height="860" Width="1150" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="New Book" Click="NewBook_Click" Padding="6,2" Margin="2"/>
            <Button Content="Delete Book" Click="DeleteBook_Click" Padding="6,2" Margin="2"/>
            <Separator/>
            <Button Content="Save Database..." Click="SaveDb_Click" Padding="6,2" Margin="2"/>
            <Button Content="Load Database..." Click="LoadDb_Click" Padding="6,2" Margin="2"/>
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="6">
                <TextBlock DockPanel.Dock="Top" Text="Books" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="BookListBox" DisplayMemberPath="Name" SelectionChanged="BookListBox_SelectionChanged"/>
            </DockPanel>

            <DockPanel Grid.Column="1" x:Name="EditorPanel" IsEnabled="False" Margin="10,8,10,10">
                <TabControl x:Name="MainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem Header="Properties">
                <DockPanel>

                <ScrollViewer DockPanel.Dock="Top" MaxHeight="500" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="Identity" Margin="0,0,0,4" Padding="6">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Name"/>
                                    <TextBox x:Name="NameBox" Width="220" HorizontalAlignment="Left" TextChanged="Field_Changed"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Weight"/>
                                    <TextBox x:Name="WeightBox" Width="60" TextChanged="Field_Changed" PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Volume"/>
                                    <TextBox x:Name="VolumeBox" Width="60" TextChanged="Field_Changed" PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Price"/>
                                    <TextBox x:Name="PriceBox" Width="60" TextChanged="Field_Changed" PreviewTextInput="IntegerOnly_PreviewTextInput"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Behavior" Margin="0,0,0,4" Padding="6">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="DestructibleCheck" Content="Destructible" Margin="0,0,20,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <CheckBox x:Name="CanBeSoldCheck" Content="Can be sold" Margin="0,0,20,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <CheckBox x:Name="CanBeTradedCheck" Content="Can be traded" Margin="0,0,20,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <CheckBox x:Name="CanBeDroppedCheck" Content="Can be dropped" Margin="0,0,20,0" Checked="Field_Changed" Unchecked="Field_Changed"/>
                                    <CheckBox x:Name="IsStackableCheck" Content="Is Stackable" Margin="0,0,20,0" Checked="Field_Changed" Unchecked="Field_Changed" ToolTip="Can another item share this book's map cell? Applies to every item type, not just books. Engine-side only - the Map Editor always shows one item per cell."/>
                                    <CheckBox x:Name="AllowElevationCheck" Content="Allow Elevation" Checked="Field_Changed" Unchecked="Field_Changed" ToolTip="Only matters if Is Stackable is also checked: does stacking raise this item visually higher, like books piled on books? Leave unchecked for something like a key sitting under a vase - stackable, but no height change. Engine-side only."/>
                                    <CheckBox x:Name="OccludesCheck" Content="Occludes" Checked="Field_Changed" Unchecked="Field_Changed" ToolTip="Blocks line of sight - the player can't interact with something behind this book from their current position. Off by default; most books don't block sight, but a stack of them or something authored tall enough might."/>
                                    <CheckBox x:Name="IsSolidCheck" Content="Solid" Checked="Field_Changed" Unchecked="Field_Changed" ToolTip="Blocks movement - a real, separate flag from Occludes. Off by default; most books can be walked over, but something authored to be a real obstacle could be marked solid."/>
                                    <CheckBox x:Name="IsTwoHandedCheck" Content="Two-Handed" Checked="Field_Changed" Unchecked="Field_Changed" ToolTip="Needs both hands - equipping this in the right hand makes the left hand unavailable while it's worn, matching a real two-handed weapon or a ranged weapon that needs a free hand to reload."/>
                                </WrapPanel>
                                <local:SolidSizeEditor x:Name="SolidSize" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Belongs to" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="BelongToCombo" Width="140" HorizontalAlignment="Left" SelectionChanged="Field_Changed_Combo"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Destructible sound"/>
                                        <ComboBox x:Name="DestructibleSoundCombo" Width="140" HorizontalAlignment="Left" SelectionChanged="Field_Changed_Combo" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Appearance" Margin="0,0,0,4" Padding="6">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Paper Doll Sprite" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="PaperDollNameCombo" Width="130" SelectionChanged="PaperDollNameCombo_SelectionChanged"/>
                                        <CheckBox x:Name="PaperDollFilterCheck" Content="Filter By Group" Margin="8,0,0,0" VerticalAlignment="Center" Checked="PaperDollFilterCheck_Checked" Unchecked="PaperDollFilterCheck_Unchecked"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Sprite" TextWrapping="Wrap" ToolTip="The book's world/map appearance - on a table, shelf, floor, or in inventory. Not the open-book reading art (that's Paper Doll)."/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="SpriteNameCombo" Width="130" SelectionChanged="Field_Changed_Combo"/>
                                        <CheckBox x:Name="SpriteFilterCheck" Content="Filter By Group" Margin="8,0,0,0" VerticalAlignment="Center" Checked="SpriteFilterCheck_Checked" Unchecked="SpriteFilterCheck_Unchecked"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Destroying Sprite" TextWrapping="Wrap" ToolTip="The in-progress animation while it's being destroyed - catching fire, breaking apart, etc."/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="ChatteredSpriteNameCombo" Width="130" SelectionChanged="Field_Changed_Combo"/>
                                        <CheckBox x:Name="ChatteredFilterCheck" Content="Filter By Group" Margin="8,0,0,0" VerticalAlignment="Center" Checked="ChatteredFilterCheck_Checked" Unchecked="ChatteredFilterCheck_Unchecked"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Destroyed Sprite" TextWrapping="Wrap" ToolTip="The final result once destruction finishes - the remains, ash, or wreckage left behind."/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="DestroyedSpriteNameCombo" Width="130" SelectionChanged="Field_Changed_Combo"/>
                                        <CheckBox x:Name="DestroyedFilterCheck" Content="Filter By Group" Margin="8,0,0,0" VerticalAlignment="Center" Checked="DestroyedFilterCheck_Checked" Unchecked="DestroyedFilterCheck_Unchecked"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="Faction"/>
                                    <ComboBox x:Name="FactionCombo" Width="120" HorizontalAlignment="Left" SelectionChanged="Field_Changed_Combo" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Left" Margin="0,6,0,0">
                                    <TextBlock Text="Text Font" ToolTip="What this book's pages are written in: the ordinary system font (as before), or a graphical font from the Sprite Editor's Fonts group. Text size 12 is the font's own pixel size, 24 is double."/>
                                    <ComboBox x:Name="TextFontCombo" Width="190" HorizontalAlignment="Left" SelectionChanged="Field_Changed_Combo"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Interaction Sounds" Padding="6">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Open sound"/>
                                    <ComboBox x:Name="OpenSoundCombo" Width="140" HorizontalAlignment="Left" SelectionChanged="Field_Changed_Combo" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="Close sound"/>
                                    <ComboBox x:Name="CloseSoundCombo" Width="140" HorizontalAlignment="Left" SelectionChanged="Field_Changed_Combo" DisplayMemberPath="Name"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Page flip sound"/>
                                    <ComboBox x:Name="FlipSoundCombo" Width="140" HorizontalAlignment="Left" SelectionChanged="Field_Changed_Combo" DisplayMemberPath="Name"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Page navigation - pages are now fully computed by the overflow engine -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,6">
                    <Button Content="&lt; Prev Page" Click="PrevPage_Click" Padding="6,2" Margin="2"/>
                    <TextBlock x:Name="PageIndicatorText" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
                    <Button Content="Next Page &gt;" Click="NextPage_Click" Padding="6,2" Margin="2"/>
                    <TextBlock Text="(pages are automatic - typing past a frame's capacity creates a new one)"
                               VerticalAlignment="Center" Margin="16,0,0,0" FontStyle="Italic" Foreground="Gray"/>
                </StackPanel>

                <!-- Drawing toolbar -->
                <ToolBar DockPanel.Dock="Top" Margin="0,0,0,6">
                    <ToggleButton x:Name="SelectToolButton" Content="Select / Move" Click="Tool_Click" IsChecked="True" Padding="6,2" Margin="2"/>
                    <ToggleButton x:Name="RectangleToolButton" Content="Rectangle" Click="Tool_Click" Padding="6,2" Margin="2"/>
                    <ToggleButton x:Name="EllipseToolButton" Content="Ellipse" Click="Tool_Click" Padding="6,2" Margin="2"/>
                    <ToggleButton x:Name="LineToolButton" Content="Line (click points)" Click="Tool_Click" Padding="6,2" Margin="2"/>
                    <ToggleButton x:Name="FreehandToolButton" Content="Pencil (freehand)" Click="Tool_Click" Padding="6,2" Margin="2"/>
                    <Separator/>
                    <Button x:Name="FinishShapeButton" Content="Finish Shape" Click="FinishShape_Click" Padding="6,2" Margin="2" IsEnabled="False"/>
                    <Separator/>
                    <TextBlock Text="Frame color:" VerticalAlignment="Center" Margin="4,0"/>
                    <Button x:Name="FrameColorButton" Click="FrameColorButton_Click" Padding="4,2" Margin="2" Width="60">
                        <Rectangle x:Name="FrameColorPreview" Width="40" Height="14" Stroke="Black" StrokeThickness="0.5"/>
                    </Button>
                    <Popup x:Name="FrameColorPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=FrameColorButton}">
                        <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="6">
                            <StackPanel Width="200">
                                <TextBlock Text="Standard" FontWeight="Bold" Margin="0,0,0,4"/>
                                <UniformGrid x:Name="FrameSwatchGrid" Columns="8" Margin="0,0,0,8"/>
                                <Button Content="Custom Color..." Click="FrameCustomColor_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Separator/>
                    <Button x:Name="DeleteFrameButton" Content="Delete Selected Frame" Click="DeleteFrame_Click" Padding="6,2" Margin="2"/>
                    <Separator/>
                    <Button x:Name="CopyFrameButton" Content="Copy Frame" Click="CopyFrame_Click" Padding="6,2" Margin="2"/>
                    <Button x:Name="PasteFrameButton" Content="Paste Frame" Click="PasteFrame_Click" Padding="6,2" Margin="2"/>
                    <Separator/>
                    <Button x:Name="PreviewButton" Content="Preview" Click="PreviewButton_Click" Padding="6,2" Margin="2"/>
                    <Separator/>
                    <Button x:Name="DiagnosticCheckButton" Content="Check Image (Debug)" Click="DiagnosticCheckButton_Click" Padding="6,2" Margin="2"/>
                    <Button x:Name="DiagnosticPaginationButton" Content="Check Pagination (Debug)" Click="DiagnosticPaginationButton_Click" Padding="6,2" Margin="2"/>
                </ToolBar>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontStyle="Italic" Foreground="Gray"
                           Text="Draw a frame on the paper doll, then double-click inside it to type its text. Frames are editor-only guides - not shown in game."/>

                <!-- Paper doll preview / drawing surface -->
                <Border BorderBrush="Gray" BorderThickness="1" Background="#FF3A3A3A">
                    <Viewbox Stretch="Uniform">
                        <Border BorderBrush="Goldenrod" BorderThickness="2">
                            <Canvas x:Name="PreviewCanvas" Width="700" Height="400" Background="Black"
                                    MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                                    MouseMove="PreviewCanvas_MouseMove"
                                    MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp">
                                <Image x:Name="PaperDollImage" Width="700" Height="400" Stretch="Uniform" IsHitTestVisible="False"/>
                            </Canvas>
                        </Border>
                    </Viewbox>
                </Border>

            </DockPanel>
                </TabItem>

                <TabItem Header="Event">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="EventDebugButton" Content="Debug" Padding="10,4" Click="EventDebugButton_Click"/>
                            <TextBlock Text="Evaluates this page's conditions against a simulated scenario, then (if they pass) lets you step through its commands one at a time - a real command executes for real when you step onto it."
                                       VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7" FontSize="11"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
                                <local:BookEventConditionsControl x:Name="BookConditionsControl"/>
                            </Border>
                            <ContentControl x:Name="EventEnginePlaceholder" Grid.Column="1"/>
                        </Grid>
                    </DockPanel>
                </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
