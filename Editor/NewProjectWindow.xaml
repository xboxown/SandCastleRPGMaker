<Window x:Class="SandcastleRpgMaker.Editor.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project" Height="420" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="New Project" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Project Name:" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="ProjectNameBox" Margin="0,0,0,4" TextChanged="ProjectNameBox_TextChanged"/>
        <TextBlock Margin="0,0,0,14" Opacity="0.7" FontSize="11" TextWrapping="Wrap">
            <Run Text="Folder/project-file name (spaces become dots so it never collides with the display name on disk): "/>
            <Run x:Name="FolderNamePreviewText" FontFamily="Consolas"/>
        </TextBlock>

        <TextBlock Text="Location:" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="LocationBox" Margin="0,0,6,0" TextChanged="LocationBox_TextChanged"/>
            <Button Grid.Column="1" Content="Browse..." Width="80" Click="BrowseButton_Click"/>
        </Grid>
        <TextBlock x:Name="FullPathPreviewText" Margin="0,0,0,14" Opacity="0.7" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>

        <TextBlock Margin="0,0,0,16" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                   Text="One project for every platform: you choose Windows, Linux, Mac, MorphOS, AmigaOS 4 or Amiga 68k when you build the game (Game > Build...)."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create" Width="90" Margin="4" Click="CreateButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
