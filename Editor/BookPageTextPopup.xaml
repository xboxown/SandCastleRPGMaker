<Window x:Class="SandcastleRpgMaker.Editor.BookPageTextPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Page Text" Height="480" Width="680" MinHeight="320" MinWidth="620"
        Background="#FFE8E4D8" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="6">
        <ToolBar DockPanel.Dock="Top" Background="#FFF6DE9A">
            <Button Content="B" FontWeight="Bold" Click="Bold_Click" Width="26"/>
            <Button Content="I" FontStyle="Italic" Click="Italic_Click" Width="26"/>
            <Button Content="U" Click="Underline_Click" Width="26"/>
            <Separator/>
            <ComboBox x:Name="FontFamilyCombo" Width="150" SelectionChanged="FontFamilyCombo_SelectionChanged"/>
            <ComboBox x:Name="FontSizeCombo" Width="55" SelectionChanged="FontSizeCombo_SelectionChanged"/>
            <Separator/>
            <Button x:Name="FontColorButton" Content="Font Color" Click="FontColorButton_Click" Width="80"/>
            <Separator/>
            <Button x:Name="BackgroundColorButton" Content="Background Color" Click="BackgroundColorButton_Click" Width="110"/>
            <Separator/>
            <ComboBox x:Name="SpriteCombo" Width="150" ToolTip="Only sprites that fit inside this frame (with a 32px margin on every side) are listed - resize the sprite in the Sprite Editor if it's missing."/>
            <Button x:Name="InsertSpriteButton" Content="Insert Sprite" Click="InsertSprite_Click" Width="80"/>
            <CheckBox x:Name="SpriteFilterByGroupCheck" Content="Filter By Group" VerticalAlignment="Center" Margin="6,0,0,0"
                      Checked="SpriteFilterByGroupCheck_Checked" Unchecked="SpriteFilterByGroupCheck_Unchecked"/>
            <TextBlock x:Name="SpriteIgnoredCountText" Foreground="Red" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11"/>
        </ToolBar>

        <Popup x:Name="FontColorPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=FontColorButton}">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="6">
                <StackPanel Width="200">
                    <TextBlock Text="Standard" FontWeight="Bold" Margin="0,0,0,4"/>
                    <UniformGrid x:Name="SwatchGrid" Columns="8" Margin="0,0,0,8"/>
                    <Button Content="Custom Color..." Click="CustomColor_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="BackgroundColorPopup" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=BackgroundColorButton}">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="6">
                <StackPanel Width="200">
                    <TextBlock Text="Standard" FontWeight="Bold" Margin="0,0,0,4"/>
                    <UniformGrid x:Name="BackgroundSwatchGrid" Columns="8" Margin="0,0,0,8"/>
                    <Button Content="Custom Color..." Click="CustomBackgroundColor_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <Border x:Name="EditorFrameBorder" BorderBrush="Gray" BorderThickness="1" Margin="0,6,0,0" Background="#FFFFF6E0">
            <RichTextBox x:Name="Editor" Background="Transparent" BorderThickness="0" TextChanged="Editor_TextChanged"/>
        </Border>
    </DockPanel>
</Window>
