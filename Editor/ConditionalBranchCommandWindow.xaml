<Window x:Class="SandcastleRpgMaker.Editor.ConditionalBranchCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conditional Branch" Height="340" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Branch based on:" FontWeight="Bold" Margin="0,0,0,4"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="SwitchRadio" Content="A Switch" GroupName="BranchMode" Checked="ModeRadio_Checked" Margin="0,0,16,0"/>
            <RadioButton x:Name="VariableRadio" Content="A Variable" GroupName="BranchMode" Checked="ModeRadio_Checked"/>
        </StackPanel>

        <StackPanel x:Name="SwitchPanel" DockPanel.Dock="Top">
            <TextBlock Text="Switch:" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="..." Width="32" Click="PickSwitch_Click"/>
                <TextBox x:Name="SwitchNameBox" IsReadOnly="True" Margin="0,0,4,0"/>
            </DockPanel>
            <TextBlock Text="Enter the branch when it is:" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="SwitchTrueRadio" Content="On (True)" GroupName="SwitchIs" Margin="0,0,16,0"/>
                <RadioButton x:Name="SwitchFalseRadio" Content="Off (False)" GroupName="SwitchIs"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="VariablePanel" DockPanel.Dock="Top">
            <TextBlock Text="Variable:" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="..." Width="32" Click="PickVariable_Click"/>
                <TextBox x:Name="VariableNameBox" IsReadOnly="True" Margin="0,0,4,0"/>
            </DockPanel>
            <TextBlock Text="Enter the branch when it is:" Margin="0,0,0,4"/>
            <ComboBox x:Name="ComparisonCombo" Margin="0,0,0,10">
                <ComboBoxItem Content="=="/>
                <ComboBoxItem Content="!="/>
                <ComboBoxItem Content="&gt;"/>
                <ComboBoxItem Content="&gt;="/>
                <ComboBoxItem Content="&lt;"/>
                <ComboBoxItem Content="&lt;="/>
            </ComboBox>
            <TextBlock Text="this value:" Margin="0,0,0,4"/>
            <TextBox x:Name="VariableValueBox" Margin="0,0,0,10"/>
        </StackPanel>

        <CheckBox x:Name="IncludeElseCheck" DockPanel.Dock="Top" Content="Also add an Else branch" Margin="0,4,0,0"/>
        <TextBlock x:Name="IncludeElseNote" DockPanel.Dock="Top" Text="Editing an existing branch only changes its condition - its own Else/End Branch (if any) are separate commands, managed on their own."
                   FontStyle="Italic" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
    </DockPanel>
</Window>
