<Window x:Class="SandcastleRpgMaker.Editor.PaperdollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory" Height="560" Width="720" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Party member:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="PartyMemberCombo" Width="200" DisplayMemberPath="Name" SelectionChanged="PartyMemberCombo_SelectionChanged"/>
            <TextBlock Text="  (number keys 1-9 also switch, matching Exult's own real keys)" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Close" Width="80" Margin="4" Click="CloseButton_Click"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Paperdoll - click an item below, then click a slot to equip it there. Click an equipped slot to unequip." Opacity="0.7" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border BorderBrush="#FF555555" BorderThickness="1">
                    <Canvas x:Name="PaperdollDisplayCanvas" Width="320" Height="400" Background="#FF2A2A2A" ClipToBounds="True"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Backpack" FontWeight="Bold"/>
                <TextBlock x:Name="SelectedItemHint" Text="" Opacity="0.8" FontSize="11" Margin="0,2,0,6"/>
                <ListBox x:Name="BackpackListBox" Height="420" DisplayMemberPath="DisplayText" SelectionChanged="BackpackListBox_SelectionChanged"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
