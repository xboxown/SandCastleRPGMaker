<Window x:Class="SandcastleRpgMaker.Editor.ShakeScreenCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shake Screen" Height="290" Width="380" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="70" Margin="4" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Intensity:" FontWeight="Bold" Margin="0,0,0,4"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" x:Name="IntensityValueLabel" Text="5" Width="24" TextAlignment="Right"/>
            <Slider x:Name="IntensitySlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                    ValueChanged="IntensitySlider_ValueChanged" Margin="0,0,8,0"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="Duration (seconds):" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox x:Name="DurationBox" DockPanel.Dock="Top" Margin="0,0,0,14"/>

        <CheckBox x:Name="AffectsCharactersCheck" DockPanel.Dock="Top" Content="NPC/PC affected by earthquake" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" FontSize="11"
                   Text="Ultima 7-style: characters fall down and stand back up while the ground shakes. Stored and ready, but there's nothing in this Preview to demonstrate it on yet - it needs real NPCs/PCs placed on a map, which doesn't exist until the Map Editor does."/>
    </DockPanel>
</Window>
