<Window x:Class="SandcastleRpgMaker.Editor.AddCommandPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Commands" Height="640" Width="600" MinHeight="300" MinWidth="420" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Greyed-out commands aren't built yet."
                   TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Page 1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,10,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Message" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Show Text..." Margin="0,0,0,4" Click="ShowText_Click" ToolTip="A line of text - with replies (choices) if you add them on its right side"/>
                        <Button Content="Stop Conversation" Margin="0,0,0,4" Click="StopConversation_Click" ToolTip="Ends the conversation: pinned replies stop coming back, and the box closes once the lines already up are read. Commands after it still run (e.g. Attack)."/>
                        <Button Content="Input Number..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Select Item..." Margin="0,0,0,12" IsEnabled="False"/>

                        <TextBlock Text="Game Progression" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Control Switches..." Margin="0,0,0,4" Click="SetSwitch_Click"/>
                        <Button Content="Control Variables..." Margin="0,0,0,4" Click="SetVariable_Click"/>
                        <Button Content="Control Self Switch..." Margin="0,0,0,12" IsEnabled="False"/>

                        <TextBlock Text="Flow Control" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Conditional Branch..." Margin="0,0,0,4" Click="ConditionalBranch_Click"/>
                        <Button Content="Advance IF..." Margin="0,0,0,4" Click="AdvancedIf_Click" ToolTip="A branch on any game condition: items, characters, what has happened, time, events... (numbered tabs)"/>
                        <Button Content="Label..." Margin="0,0,0,4" Click="Label_Click"/>
                        <Button Content="Jump to Label..." Margin="0,0,0,4" Click="JumpToLabel_Click"/>
                        <Button Content="Exit Event Processing" Margin="0,0,0,4" Click="ExitEvent_Click" ToolTip="Stops the commands right here - ends a conversation too"/>
                        <Button Content="Cinema Mode" Margin="0,0,0,4" Tag="CinemaMode" Click="Registered_Click" ToolTip="Adds Cinema Mode and End Cinema Mode: while the commands between them run, the player can't move or click anything (only read the boxes and pick replies). The event ending ends it too."/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Party / Item" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Give Item..." Margin="0,0,0,4" Click="Registered_Click" Tag="GiveItem" ToolTip="One character gives an item to another - from what they really have, or not; someone who can't carry it gets help from the party, or it's put down at their feet"/>
                        <Button Content="Exchange Currency..." Margin="0,0,0,4" Click="ExchangeCurrency_Click" ToolTip="A money changer: the party's money of one currency into another, at the Currency Editor's rate"/>
                        <Button Content="Remove Item..." Margin="0,0,0,12" IsEnabled="False"/>

                        <TextBlock Text="Actor" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Change HP..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Change Stat..." Margin="0,0,0,4" Click="Registered_Click" Tag="ChangeStat" ToolTip="Set, raise or lower a stat - for ever, or for some game minutes or hours"/>
                        <Button Content="Reset Stat..." Margin="0,0,0,4" Click="Registered_Click" Tag="ResetStat" ToolTip="Takes back every Change Stat on a stat (or all of them); training is kept"/>
                        <Button Content="Train..." Margin="0,0,0,4" Click="Registered_Click" Tag="Train" ToolTip="A trainer raises stats for training points and money"/>
                        <Button Content="Kill Character..." Margin="0,0,0,4" Click="Registered_Click" Tag="KillCharacter" ToolTip="A fatal blow (the hit flash) and they die"/>
                        <Button Content="Food Level..." Margin="0,0,0,4" Click="ChangeFoodLevel_Click"/>
                        <Button Content="Modify Ailments..." Margin="0,0,0,4" Click="ModifyAilments_Click"/>
                        <Button Content="Attack..." Margin="0,0,0,4" Click="Attack_Click"/>
                        <Button Content="Change State..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Change Behavior..." Margin="0,0,0,12" Click="ChangeBehavior_Click"/>

                        <TextBlock Text="Movement / World" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Teleport..." Margin="0,0,0,4" Click="Teleport_Click"/>
                        <Button Content="Sleep On Bed..." Margin="0,0,0,4" Click="SleepOnBed_Click" ToolTip="The main character walks to a bed and lies down, as double-clicking it does (for a bed's cover)"/>
                        <Button Content="Paperdoll..." Margin="0,0,0,4" Click="Paperdoll_Click" ToolTip="Change a paperdoll's parts, play or stop its sounds, close it, or turn its object into another object"/>
                        <Button Content="Play Sound..." Margin="0,0,0,4" Click="PlaySound_Click" ToolTip="Plays a sound once or looping, at a volume you choose"/>
                        <Button Content="Stop Sound..." Margin="0,0,0,4" Click="StopSound_Click" ToolTip="Stops a sound that is playing (a looping one, say), or every sound"/>
                        <Button Content="Open Paperdoll..." Margin="0,0,0,4" Click="Registered_Click" Tag="OpenPaperdoll" ToolTip="Opens a PaperDoll Editor paperdoll - modal or not, its Yes / No answer into a variable"/>
                        <Button Content="Play Video..." Margin="0,0,0,4" Click="Registered_Click" Tag="PlayVideo" ToolTip="Plays a video from the Video Library over the whole game - the game waits till it ends"/>
                        <Button Content="Change Tile..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Wait..." Margin="0,0,0,4" Tag="Wait" Click="Registered_Click" ToolTip="Pauses the event for some seconds, game minutes or game hours before its next command"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Page 2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,10,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Screen &amp; Atmosphere" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Shake Screen..." Margin="0,0,0,4" Click="ShakeScreen_Click"/>
                        <Button Content="Change Day/Night..." Margin="0,0,0,4" Click="ChangeDayNight_Click"/>
                        <Button Content="Change Weather..." Margin="0,0,0,4" Click="ChangeWeather_Click" ToolTip="Rain, snow, hail, a storm or clear skies, and the clouds"/>
                        <Button Content="Apply Palette Color..." Margin="0,0,0,12" Click="ApplyPaletteColor_Click"/>

                        <TextBlock Text="Factions" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Change Faction Relationship..." Margin="0,0,0,4" Click="ChangeFactionRelationship_Click"/>
                        <Button Content="Change Faction..." Margin="0,0,0,4" Click="ChangeFaction_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Books" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Change Self Book Content..." Margin="0,0,0,4" Click="ChangeSelfBookContent_Click"/>
                        <Button Content="Change External Book Content..." Margin="0,0,0,4" Click="ChangeExternalBookContent_Click"/>
                        <Button Content="Change Book Settings..." Margin="0,0,0,4" Click="ChangeBookSettings_Click"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Actions">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,10,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Items &amp; Equipment" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Pickup Item..." Margin="0,0,0,4" Click="Registered_Click" Tag="PickupItem" ToolTip="Walks to a thing on the map and picks it up"/>
                        <Button Content="Drop Item..." Margin="0,0,0,4" Click="Registered_Click" Tag="DropItem" ToolTip="Puts something they carry down - at their feet or at a spot"/>
                        <Button Content="Pick Item From Container..." Margin="0,0,0,4" Click="Registered_Click" Tag="TakeFromContainer" ToolTip="Walks to an unlocked container and takes things out of it"/>
                        <Button Content="Equip Equipment..." Margin="0,0,0,4" Click="Registered_Click" Tag="EquipItem" ToolTip="Readies a weapon or armor they carry"/>
                        <Button Content="Unequip Equipment..." Margin="0,0,0,12" Click="Registered_Click" Tag="UnequipItem" ToolTip="Takes it off into their pack (or drops it)"/>

                        <TextBlock Text="Doors &amp; Fighting" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Open Door..." Margin="0,0,0,4" Click="Registered_Click" Tag="OpenDoor" ToolTip="Walks to a door and opens it - with their key if it's locked"/>
                        <Button Content="Picklock Door..." Margin="0,0,0,4" Click="Registered_Click" Tag="PicklockDoor" ToolTip="Walks to a locked door and picks the lock"/>
                        <Button Content="Attack Object..." Margin="0,0,0,4" Click="Registered_Click" Tag="AttackObject" ToolTip="Walks to a thing and strikes it until it breaks"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Moving &amp; Poses" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Walk To Location..." Margin="0,0,0,4" Click="Registered_Click" Tag="WalkToLocation" ToolTip="Walks to a spot on the floor they're on, round whatever is in the way"/>
                        <Button Content="Walk To Floor Location..." Margin="0,0,0,4" Click="Registered_Click" Tag="WalkToFloorLocation" ToolTip="Walks to a spot on a chosen floor - up or down the stairs to it"/>
                        <Button Content="Sit..." Margin="0,0,0,4" Click="Registered_Click" Tag="Sit" ToolTip="Walks to a chair and sits on it"/>
                        <Button Content="Stand" Margin="0,0,0,4" Click="Registered_Click" Tag="Stand" ToolTip="Gets up from a chair or bed"/>
                        <Button Content="Play Pose..." Margin="0,0,0,4" Click="Registered_Click" Tag="PlayPose" ToolTip="A pose for a while, or until its animation has played"/>
                        <Button Content="Change Pose..." Margin="0,0,0,4" Click="Registered_Click" Tag="ChangePose" ToolTip="Shows a pose and keeps it"/>
                        <Button Content="Play Animation..." Margin="0,0,0,4" Click="Registered_Click" Tag="PlayAnimation" ToolTip="A sprite's animation and sounds at a spot or over someone"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
