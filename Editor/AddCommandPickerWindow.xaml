<Window x:Class="SandcastleRpgMaker.Editor.AddCommandPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Commands" Height="640" Width="600" MinHeight="300" MinWidth="420" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Show Text (with replies), Label / Jump to Label, Control Switches/Variables, Conditional Branch, Play Sound/Music, Shake Screen, Change Day/Night, Apply Palette Color, and both Change Book Content commands are built so far - everything else is shown to prove the category structure, and will light up as each is built."
                   TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Page 1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,10,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Message" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Show Text..." Margin="0,0,0,4" Click="ShowText_Click"/>
                        <Button Content="Show Text with Replies..." Margin="0,0,0,4" Click="ShowText_Click" ToolTip="Replies (choices) are part of Show Text: add them on its right side"/>
                        <Button Content="Stop Conversation" Margin="0,0,0,4" Click="StopConversation_Click" ToolTip="Ends the conversation: pinned replies stop coming back, and the box closes once the lines already up are read. Commands after it still run (e.g. Attack)."/>
                        <Button Content="Input Number..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Select Item..." Margin="0,0,0,12" IsEnabled="False"/>

                        <TextBlock Text="Game Progression" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Control Switches..." Margin="0,0,0,4" Click="SetSwitch_Click"/>
                        <Button Content="Control Variables..." Margin="0,0,0,4" Click="SetVariable_Click"/>
                        <Button Content="Control Self Switch..." Margin="0,0,0,12" IsEnabled="False"/>

                        <TextBlock Text="Flow Control" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Conditional Branch..." Margin="0,0,0,4" Click="ConditionalBranch_Click"/>
                        <Button Content="Label..." Margin="0,0,0,4" Click="Label_Click"/>
                        <Button Content="Jump to Label..." Margin="0,0,0,4" Click="JumpToLabel_Click"/>
                        <Button Content="Exit Event Processing" Margin="0,0,0,4" Click="ExitEvent_Click" ToolTip="Stops the commands right here - ends a conversation too"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Party / Item" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Give Item..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Exchange Currency..." Margin="0,0,0,4" Click="ExchangeCurrency_Click" ToolTip="A money changer: the party's money of one currency into another, at the Currency Editor's rate"/>
                        <Button Content="Remove Item..." Margin="0,0,0,12" IsEnabled="False"/>

                        <TextBlock Text="Actor" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Change HP..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Food Level..." Margin="0,0,0,4" Click="ChangeFoodLevel_Click"/>
                        <Button Content="Modify Ailments..." Margin="0,0,0,4" Click="ModifyAilments_Click"/>
                        <Button Content="Attack..." Margin="0,0,0,4" Click="Attack_Click"/>
                        <Button Content="Change State..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Change Behavior..." Margin="0,0,0,12" Click="ChangeBehavior_Click"/>

                        <TextBlock Text="Movement / World" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Teleport..." Margin="0,0,0,4" Click="Teleport_Click"/>
                        <Button Content="Sleep On Bed..." Margin="0,0,0,4" Click="SleepOnBed_Click" ToolTip="The main character walks to a bed and lies down, as double-clicking it does (for a bed's cover)"/>
                        <Button Content="Paperdoll..." Margin="0,0,0,4" Click="Paperdoll_Click" ToolTip="Change a paperdoll's parts, play or stop its sounds, close it, or turn its object into another object"/>
                        <Button Content="Play Sound..." Margin="0,0,0,4" Click="PlaySound_Click"/>
                        <Button Content="Play Music..." Margin="0,0,0,4" Click="PlayMusic_Click"/>
                        <Button Content="Change Tile..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Wait..." Margin="0,0,0,4" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Page 2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,10,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Screen &amp; Atmosphere" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Shake Screen..." Margin="0,0,0,4" Click="ShakeScreen_Click"/>
                        <Button Content="Change Day/Night..." Margin="0,0,0,4" Click="ChangeDayNight_Click"/>
                        <Button Content="Apply Palette Color..." Margin="0,0,0,12" Click="ApplyPaletteColor_Click"/>

                        <TextBlock Text="Factions" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Change Faction Relationship..." Margin="0,0,0,4" Click="ChangeFactionRelationship_Click"/>
                        <Button Content="Change Faction..." Margin="0,0,0,4" Click="ChangeFaction_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Books" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Change Self Book Content..." Margin="0,0,0,4" Click="ChangeSelfBookContent_Click"/>
                        <Button Content="Change External Book Content..." Margin="0,0,0,4" Click="ChangeExternalBookContent_Click"/>
                        <Button Content="Change Book Settings..." Margin="0,0,0,4" Click="ChangeBookSettings_Click"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
