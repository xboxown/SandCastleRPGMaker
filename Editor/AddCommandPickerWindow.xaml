<Window x:Class="SandcastleRpgMaker.Editor.AddCommandPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Commands" Height="480" Width="560" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Show Text, Control Switches/Variables, Conditional Branch, Play Sound/Music, Shake Screen, Change Day/Night, Apply Palette Color, and both Change Book Content commands are built so far - everything else is shown to prove the category structure, and will light up as each is built."
                   TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="4" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Page 1">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Message" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Show Text..." Margin="0,0,0,4" Click="ShowText_Click"/>
                        <Button Content="Show Choices..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Input Number..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Select Item..." Margin="0,0,0,12" IsEnabled="False"/>

                        <TextBlock Text="Game Progression" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Control Switches..." Margin="0,0,0,4" Click="SetSwitch_Click"/>
                        <Button Content="Control Variables..." Margin="0,0,0,4" Click="SetVariable_Click"/>
                        <Button Content="Control Self Switch..." Margin="0,0,0,12" IsEnabled="False"/>

                        <TextBlock Text="Flow Control" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Conditional Branch..." Margin="0,0,0,4" Click="ConditionalBranch_Click"/>
                        <Button Content="Label / Jump to Label..." Margin="0,0,0,4" IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Party / Item" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Give Item..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Remove Item..." Margin="0,0,0,12" IsEnabled="False"/>

                        <TextBlock Text="Actor" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Change HP..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Change State..." Margin="0,0,0,12" IsEnabled="False"/>

                        <TextBlock Text="Movement / World" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Teleport..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Play Sound..." Margin="0,0,0,4" Click="PlaySound_Click"/>
                        <Button Content="Play Music..." Margin="0,0,0,4" Click="PlayMusic_Click"/>
                        <Button Content="Change Tile..." Margin="0,0,0,4" IsEnabled="False"/>
                        <Button Content="Wait..." Margin="0,0,0,4" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Page 2">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Screen &amp; Atmosphere" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Shake Screen..." Margin="0,0,0,4" Click="ShakeScreen_Click"/>
                        <Button Content="Change Day/Night..." Margin="0,0,0,4" Click="ChangeDayNight_Click"/>
                        <Button Content="Apply Palette Color..." Margin="0,0,0,12" Click="ApplyPaletteColor_Click"/>

                        <TextBlock Text="Factions" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Change Faction Relationship..." Margin="0,0,0,4" Click="ChangeFactionRelationship_Click"/>
                        <Button Content="Change Faction..." Margin="0,0,0,4" Click="ChangeFaction_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Books" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Button Content="Change Self Book Content..." Margin="0,0,0,4" Click="ChangeSelfBookContent_Click"/>
                        <Button Content="Change External Book Content..." Margin="0,0,0,4" Click="ChangeExternalBookContent_Click"/>
                        <Button Content="Change Book Settings..." Margin="0,0,0,4" Click="ChangeBookSettings_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
